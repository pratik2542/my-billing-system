# ==========================================
# Universal Billing System - Environment Configuration
# ==========================================

# --- Firebase Client Web App Config ---
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=billingsystem-225be.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=billingsystem-225be
VITE_FIREBASE_STORAGE_BUCKET=billingsystem-225be.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=241711343750
VITE_FIREBASE_APP_ID=1:241711343750:web:...
VITE_FIREBASE_MEASUREMENT_ID=G-...
VITE_GEMINI_API_KEY=AIzaSy...

# --- Automated Weekly Backup & Email Configuration ---
BACKUP_EMAIL_TO=admin@example.com

# Email Dispatch Method 1: Gmail App Password (100% Free - Recommended)
# Generate from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# Email Dispatch Method 2: Custom SMTP (Brevo / Resend / SendGrid / Mailgun)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# --- Firestore Authentication for Backup Service ---
# Option A: Login with Admin account credentials
FIREBASE_AUTH_EMAIL=admin@yourbilling.com
FIREBASE_AUTH_PASSWORD=yourAdminPassword

# Option B: Path to Service Account JSON (or raw JSON in FIREBASE_SERVICE_ACCOUNT_KEY)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Cron Daemon Settings ---
# Default schedule: '0 0 * * 0' (Every Sunday at 00:00:00 midnight)
CRON_SCHEDULE=0 0 * * 0
RUN_ON_STARTUP=false

# --- Offline License Signing Keys (Do NOT commit real keys) ---
# LICENSE_PRIVATE_KEY=your-ed25519-private-key-hex
# VITE_LICENSE_PRIVATE_KEY=your-ed25519-private-key-hex

