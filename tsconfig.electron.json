{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "outDir": ".",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "electron/**/*.ts",
    "installer/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "*.tsx",
    "App.tsx",
    "OfflineApp.tsx",
    "index.tsx",
    "types.ts",
    "constants.ts",
    "firebase.ts",
    "components/**"
  ]
}
